{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.4.1",
  "description": "Cached ChatGPT usage analytics with single-flight incremental sync and 24h/7d/30d model trends.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "meter.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
