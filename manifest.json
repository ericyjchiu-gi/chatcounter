{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.7.1",
  "description": "Universal ChatGPT usage analytics with adaptive staged backfill, shared Sync & History status, structured diagnostics, and metadata-only storage.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "api.js",
        "tasks.js",
        "sync.js",
        "live.js",
        "ui.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
