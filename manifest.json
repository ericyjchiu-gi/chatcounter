{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.9.0",
  "description": "Private local ChatGPT usage analytics with onboarding, plan-aware Advanced Chat limits, progressive coverage, adaptive pacing, portable index backups and bilingual light/dark UI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "i18n.js",
        "limits.js",
        "api.js",
        "tasks.js",
        "policy.js",
        "sync.js",
        "live.js",
        "ui.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "1.9.0",
  "key": ""
}
