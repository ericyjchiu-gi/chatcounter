{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.6.4",
  "description": "Orion-compatible ChatGPT usage cache with native cross-tab locking, verified persistence, explicit sync diagnostics, and cleaner initial-build UI.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "webext.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "sync-lock.js",
        "meter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
