{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "2.0.1",
  "description": "ChatGPT saved-history usage estimates with a native toolbar popup, background reconciliation, local index backups and readable quota badges.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/shared/webext.js",
        "src/content/bridge.js",
        "src/shared/core.js",
        "src/shared/i18n.js",
        "src/shared/limits.js",
        "src/shared/tasks.js",
        "src/shared/policy.js",
        "src/content/view-client.js",
        "src/content/ui.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/live.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "version_name": "2.0.1",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ChatGPT Message Meter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}
