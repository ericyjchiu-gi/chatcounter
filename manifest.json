{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.7.2",
  "description": "Universal usage analytics with stage-aware Project coverage, resumable history, adaptive pacing, diagnostics and compact Sync & History.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "api.js",
        "tasks.js",
        "policy.js",
        "sync.js",
        "live.js",
        "ui.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
