{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.6.0",
  "description": "Event-driven ChatGPT usage analytics with live capture, multi-tab coordination, incremental reconciliation, plan-aware quota safety, and local history cache.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "meter.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
