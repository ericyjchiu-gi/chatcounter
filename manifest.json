{
  "manifest_version": 3,
  "name": "ChatGPT Message Meter",
  "version": "1.5.0",
  "description": "Cached ChatGPT usage analytics with account-plan detection, plan-aware quota safety logic, and single-flight incremental sync.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "meter.js",
        "plan-aware-v15.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
